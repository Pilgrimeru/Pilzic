# Discord bot token
TOKEN=token
# Maximum number of tracks returned per playlist (Spotify/Deezer are capped at 50)
MAX_PLAYLIST_SIZE=50
# Maximum tracks retained per server
MAX_QUEUE_SIZE=500
# Command prefix
PREFIX=!
# Automatically delete bot responses
AUTO_DELETE=true
# Enable autocomplete for play and insert
AUTOCOMPLETE=true
# Language setting, must exist in the local folder
LOCALE=en
# Seconds before disconnecting when the bot is alone (0 to disable)
STAY_TIME=30
# Default volume [0;100]
DEFAULT_VOLUME=100
# Main color for the bot
MAIN_COLOR=#69ADC7

# ADVANCED
# Cache size in MB
CACHE_SIZE=50
USERAGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Dedicated cookies created by bun run youtube-login
YOUTUBE_COOKIES_PATH=./secrets/youtube-cookies.txt
# Startup retries for transient errors
YOUTUBE_MAX_RETRIES=1
# Retries for rate limits and transient network errors
SOUNDCLOUD_MAX_RETRIES=1
AUDIO_CACHE_MAX_FILES=50
AUDIO_CACHE_MAX_MB=500
AUDIO_PRELOAD_COUNT=5
AUDIO_PRELOAD_CONCURRENCY=2
# Shared yt-dlp, FFmpeg, metadata and external stream slots
AUDIO_JOB_CONCURRENCY=4
# Shared YouTube search slots
SEARCH_CONCURRENCY=4
# Used only when a source must be transcoded
OPUS_BITRATE_KBPS=96
# FFmpeg libopus complexity (0-10)
OPUS_COMPRESSION_LEVEL=5
# Structured metrics log interval; 0 disables
CORE_METRICS_INTERVAL_SECONDS=60
# Played tracks kept for the previous command (queue loop retains its bounded queue)
QUEUE_HISTORY_SIZE=50
