TOKEN = "token" # your discord token
MAX_PLAYLIST_SIZE = 50 # Maximum number of tracks returned per playlist (Spotify/Deezer are capped at 50)
MAX_QUEUE_SIZE = 500 # Maximum tracks retained per server
PREFIX = "!" # Command prefix
AUTO_DELETE = true # Set to true to automatically delete bot responses
AUTOCOMPLETE = true # Set to true to enable autocomplete for play and insert.
LOCALE = "en" # Language setting, it must exist in the local folder
STAY_TIME = 30 # Duration in seconds to disconnect when the bot is alone (0 to disable)
DEFAULT_VOLUME = 100 # Default volume setting [0;100]
MAIN_COLOR = "#69ADC7" # Main color for the bot

# ADVANCED #
CACHE_SIZE = 50 # In Mb
USERAGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
YOUTUBE_COOKIES_PATH = "./secrets/youtube-cookies.txt" # Dedicated cookies created by bun run youtube-login
YOUTUBE_MAX_RETRIES = 1 # Startup retries for transient errors
SOUNDCLOUD_MAX_RETRIES = 1 # Retries for rate limits and transient network errors
AUDIO_CACHE_MAX_FILES = 50
AUDIO_CACHE_MAX_MB = 500
AUDIO_PRELOAD_COUNT = 5
AUDIO_PRELOAD_CONCURRENCY = 2
AUDIO_JOB_CONCURRENCY = 4 # Shared yt-dlp, FFmpeg, metadata and external stream slots
SEARCH_CONCURRENCY = 4 # Shared YouTube search slots
OPUS_BITRATE_KBPS = 96 # Used only when a source must be transcoded
OPUS_COMPRESSION_LEVEL = 5 # FFmpeg libopus complexity (0–10)
CORE_METRICS_INTERVAL_SECONDS = 60 # Structured metrics log interval; 0 disables
QUEUE_HISTORY_SIZE = 50 # Played tracks kept for the previous command (queue loop retains its bounded queue)
