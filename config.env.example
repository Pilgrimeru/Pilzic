TOKEN = "token" # your discord token
MAX_PLAYLIST_SIZE = 500 # Maximum number of music fetches per playlist
PREFIX = "!" # Command prefix
AUTO_DELETE = true # Set to true to automatically delete bot responses
AUTOCOMPLETE = true # Set to true to enable autocomplete for play and insert.
LOCALE = "en" # Language setting, it must exist in the local folder
STAY_TIME = 30 # Duration in seconds to disconnect when the bot is alone (0 to disable)
DEFAULT_VOLUME = 100 # Default volume setting [0;100]
MAIN_COLOR = "#69ADC7" # Main color for the bot

# ADVANCED #
CACHE_SIZE = 50 # In Mb
USERAGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
YOUTUBE_COOKIES_PATH = "/app/secrets/youtube-cookies.txt" # Netscape cookie file; mount read-only in production
YOUTUBE_MAX_RETRIES = 5 # Transient retries; authentication errors are never retried
AUDIO_CACHE_MAX_FILES = 50
AUDIO_CACHE_MAX_MB = 500
AUDIO_PRELOAD_COUNT = 5
AUDIO_PRELOAD_CONCURRENCY = 2
