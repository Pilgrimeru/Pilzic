{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun-types"],
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    // Alias configuration (TypeScript 7 no longer supports `baseUrl`)
    "paths": {
      "@commands/*": ["./src/commands/*"],
      "@core/*": ["./src/core/*"],
      "@events/*": ["./src/events/*"],
      "@utils/*": ["./src/utils/*"],
      "@custom-types/*": ["./src/types/*"],
      "@locales/*": ["./src/locales/*"],
      "@errors/*": ["./src/errors/*"],
      "config": ["./src/config.ts"],
      "i18n.config": ["./src/i18n.config.ts"],
      "index": ["./src/index.ts"]
    }
  }
}
